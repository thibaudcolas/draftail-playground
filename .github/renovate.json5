{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", ":enablePreCommit", "helpers:pinGitHubActionDigests"],
  // Match wagtail/draftjs_exporter's maintenance cadence.
  schedule: ["* * 3,22 * *"],
  timezone: "Etc/UTC",
  prConcurrentLimit: 10,
  labels: ["dependencies"],
  minimumReleaseAge: "7 days",
  dependencyDashboard: false,
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ["* * 3,22 * *"],
  },
  packageRules: [
    {
      matchCategories: ["ci"],
      automerge: true,
      groupName: "CI configuration dependencies",
    },
    {
      matchManagers: ["npm", "pep621"],
      matchUpdateTypes: ["minor", "patch", "digest", "pin"],
      automerge: true,
    },
    // Preserve the existing editor compatibility pins during the tooling migration.
    // Review these together when upgrading the React 16 / Draft.js 0.10 stack.
    {
      matchPackageNames: [
        "draft-js",
        "draftail",
        "@types/draft-js",
        "prismjs",
        "@types/prismjs",
        "react-json-view",
        "react-modal",
        "@types/react-modal",
        "react-resizable",
        "@types/react-resizable",
        "react-simpler-select",
        "react-tabs",
        "@types/react-tabs",
        "reading-time",
        "html5lib",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
      ],
      enabled: false,
    },
    {
      matchPackageNames: ["styled-components", "@types/styled-components"],
      groupName: "styled-components",
    },
    {
      matchPackageNames: ["draftjs_exporter", "draftjs_exporter_markdown"],
      groupName: "draftjs_exporter",
    },
  ],
}
